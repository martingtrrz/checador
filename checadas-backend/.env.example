# Base de datos
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=checadas_db

# JWT (sesiones de admin y token corto de checada)
JWT_SECRET=cambia_esto_por_un_valor_largo_y_aleatorio
JWT_ADMIN_EXPIRES=8h
JWT_CHECADA_EXPIRES=2m

# WebAuthn - deben coincidir EXACTO con el dominio/IP donde el iPhone
# accede al frontend.
RP_NAME=Sistema de Checadas
RP_ID=localhost
ORIGIN=http://localhost:5173

# URL publica del backend, usada para construir la ruta de las fotos
# guardadas localmente en /uploads (ej. tu IP en la red local).
BASE_URL=http://localhost:4000

PORT=4000
